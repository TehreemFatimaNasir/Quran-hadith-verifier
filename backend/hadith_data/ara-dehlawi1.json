[{"hadithnumber": 1, "text": "لیس الخبر کالمعاینة"}, {"hadithnumber": 2, "text": "الحرب خدعة"}, {"hadithnumber": 3, "text": "المسلم مراة المسلم"}, {"hadithnumber": 4, "text": "المستشار موتمن"}, {"hadithnumber": 5, "text": "الدال علی الخیر کفاعله"}, {"hadithnumber": 6, "text": "استعینوا علی الحوايج بالکتمان"}, {"hadithnumber": 7, "text": "اتقوا النار ولو بشق تمرة"}, {"hadithnumber": 8, "text": "الدنیا سجن المومن و جنة الکافر"}, {"hadithnumber": 9, "text": "الحیاء خیر کله"}, {"hadithnumber": 10, "text": "عدة المومن کاخذ الکف"}, {"hadithnumber": 11, "text": "لا یحل لمومن ان یجهر اخاه فوق ثلاثة ایام"}, {"hadithnumber": 12, "text": "لیس منا من غشنا"}, {"hadithnumber": 13, "text": "ما قل وكفى خير مما كثر والهى"}, {"hadithnumber": 14, "text": "الراجع في هبته کالراجع في قیيه"}, {"hadithnumber": 15, "text": "البلاء موکل بالمنطق"}, {"hadithnumber": 16, "text": "الناس کاسنان المشط"}, {"hadithnumber": 17, "text": "الغنى غنى النفس"}, {"hadithnumber": 18, "text": "السعید من وعظ بغیره"}, {"hadithnumber": 19, "text": "و ان من الشعر لحکمة وان من البیان لسحرا"}, {"hadithnumber": 20, "text": "عفو الملوك ابقاء للملك"}, {"hadithnumber": 21, "text": "المرء مع من احب"}, {"hadithnumber": 22, "text": "ما هلك امرو عرف قدره"}, {"hadithnumber": 23, "text": "الولد للفراش و للعاهر الحجر"}, {"hadithnumber": 24, "text": "الید العلیا خیر من الید السفلی"}, {"hadithnumber": 25, "text": "لا شکر الله من لا یشکر الناس"}, {"hadithnumber": 26, "text": "حبك الشيء یعمي و یصم"}, {"hadithnumber": 27, "text": "جبلت القلوب علی حب من احسن الیها و بغض من اساء الیها"}, {"hadithnumber": 28, "text": "التايب من الذنب کمن لا ذنب له"}, {"hadithnumber": 29, "text": "الشاهد یری ما لا یراه الغايب"}, {"hadithnumber": 30, "text": "اذا جاءکم کریم قوم فاکرموه"}, {"hadithnumber": 31, "text": "الیمین الفاجرة تدع الدیار البلاقع"}, {"hadithnumber": 32, "text": "من قتل دون ماله فهو شهید"}, {"hadithnumber": 33, "text": "الاعمال بالنیة"}, {"hadithnumber": 34, "text": "سید القوم خادمهم"}, {"hadithnumber": 35, "text": "خیر الامور اوسطها"}, {"hadithnumber": 36, "text": "اللهم بارك فی امتی فی بکورها یوم الخمیس"}, {"hadithnumber": 37, "text": "کاد الفقر ان یکون کفرا"}, {"hadithnumber": 38, "text": "السفر قطعة من العذاب"}, {"hadithnumber": 39, "text": "خیر زاد التقوی"}, {"hadithnumber": 40, "text": "المجالس بالامانة"}]